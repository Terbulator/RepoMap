# Copy to .env.local and fill in. Never commit .env.local.
# The app builds and runs with none of these set.

# ---------------------------------------------------------------------------
# Analysis provider: "mock" (default) or "bob-2.0"
# ---------------------------------------------------------------------------
# mock     -> returns src/data/mock-analysis.json (deterministic, not AI output)
# bob-2.0  -> runs the installed IBM Bob 2.0 CLI (`bob run`, headless)
REPOMAP_PROVIDER=mock

# ---------------------------------------------------------------------------
# IBM Bob 2.0 (only used when REPOMAP_PROVIDER=bob-2.0)
# ---------------------------------------------------------------------------
# Path to the `bob` executable. Default assumes it is on PATH.
# On Windows the npm shim (bob.cmd) cannot be spawned directly — point this at
# the CLI entry script instead, e.g.
#   C:\Users\<you>\AppData\Roaming\npm\node_modules\bobshell\dist\bob.js
BOB_CLI_PATH=bob

# REQUIRED for headless Bob runs: an IBM Bob API key.
# It is read from the environment by the `bob` CLI itself; RepoMap only checks
# that it is present. Do not commit a key, do not put it in client code.
# BOB_API_KEY=

# Turn limit for a single analysis task
BOB_MAX_TURNS=8

# How long a single Bob analysis may run before it is aborted (ms).
# Observed: one analysis took over 4 minutes, so keep this generous.
BOB_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
# Bob analyses a local directory. If this is set, RepoMap analyses that
# checkout as-is. Otherwise it shallow-clones the target repository into
# .repomap-cache/<owner>__<repo> (gitignored).
# REPOMAP_WORKSPACE_DIR=

# Timeout for that shallow clone (ms)
REPOMAP_CLONE_TIMEOUT_MS=120000
