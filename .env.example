# Copy to .env.local and fill in when IBM Bob 2.0 integration starts.
# These are placeholders only — no Bob 2.0 calls are made in the current build.

# Base URL of the IBM Bob 2.0 service (server-side only, never exposed to the browser)
BOB_API_BASE_URL=

# API token / key for IBM Bob 2.0 (server-side only, never exposed to the browser)
BOB_API_KEY=

# Identifier of the Bob 2.0 project or team that analyses submitted repositories
BOB_PROJECT_ID=
