# Copy to .env.local and fill in when IBM Bob 2.0 integration starts.
# The app builds and runs without these; POST /api/repomap returns 503 until
# BOB_API_BASE_URL is set. Never expose any of these to the browser.

# Base URL of the IBM Bob 2.0 service (server-side only)
BOB_API_BASE_URL=

# API token / key for IBM Bob 2.0 (server-side only)
BOB_API_KEY=

# Identifier of the Bob 2.0 project or team that analyses submitted repositories
BOB_PROJECT_ID=

# Path appended to BOB_API_BASE_URL for the repository-analysis call.
# Adjust to match the Bob 2.0 deployment you are given.
BOB_ANALYSIS_PATH=v1/repositories/analyze

# Optional model override, if the deployment lets you pick one
BOB_MODEL=

# How long to wait for a Bob 2.0 analysis before failing the request (ms)
BOB_TIMEOUT_MS=120000
